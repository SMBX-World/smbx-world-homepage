---

<BaseLayout title="作品" theme="desert">
  <header class="header clear" role="banner">
    <p class="image"><img src="/images/assets/toad.png" /></p>

    <BlockBox color="orange">
      <h2>作品</h2>
      <p>本页面列出了部分精品 SMBX 地图，点击地图即可跳转到 SMBX World 中文社区详情页。<br>
      想玩更多作品？来看看 <a href="https://station.smbx.world/" target="_blank">SMBX World 地图站</a>！</p>
    </BlockBox>
  </header>

  <main role="main">
    <section>
      <div class="archive-body">
        {episodes.map((ep) => (
          <article>
            <BlockBox color="orange">
              <div class="featured-image">
                <a href={ep.link} title={ep.title} target="_blank">
                  <img src={ep.image} alt={ep.title} />
                </a>
              </div>
              <h2>
                <a href={ep.link} title={ep.title} target="_blank">{ep.title}</a>
              </h2>
              {ep.author && <span class="author">作者：<a href={ep.authorLink} title={`Posts by ${ep.author}`} rel="author" target="_blank">{ep.author}</a></span><br />}
              <span class="smbx-version">SMBX 版本：{ep.smbx}</span><br />
              <span class="date">发布于 {ep.date.replace(/(\d+)\.(\d+)\.(\d+)/, (_, y, m, d) => `${y}-${m.padStart(2, '0')}-${d.padStart(2, '0')}`)}</span>
              <div class="episode-download">
                <a href={ep.download ?? ep.link} target="_blank" rel="noopener noreferrer"><strong>点击下载作品</strong></a>
              </div>
            </BlockBox>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
